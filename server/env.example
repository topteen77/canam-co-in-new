# MySQL Database (required for the server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=crm_db

# Firebase Admin SDK Configuration (required for Google Sign-In)
FIREBASE_PROJECT_ID=agent-follow-up-crm
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@agent-follow-up-crm.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Server Configuration
PORT=3001
NODE_ENV=production
SESSION_ENV=production

# Email Configuration (test email, bulk email, password reset)
# For Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Optional: SMTP_FROM="CRM" <your-email@gmail.com>

# Admin Configuration
ADMIN_EMAIL=canamrakesh@gmail.com
ADMIN_PASSWORD=@16Agentcrm
# Used for admin force-login and the Devices tab (not the account password)
ADMIN_MASTER_PASSWORD=change-this-master-password

# Security
JWT_SECRET=your-super-secret-jwt-key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100






















































