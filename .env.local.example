# Agent Follow-up CRM Environment Variables
# Copy this file to .env.local and fill in your actual values

# REQUIRED: Gemini AI API Key for smart follow-up suggestions
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Additional configurations
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Firebase configuration is already set in .env file
# No need to change these unless you want to use a different Firebase project
