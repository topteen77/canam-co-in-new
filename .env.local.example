# Agent Follow-up CRM Environment Variables
# Copy this file to .env.local and fill in your actual values

# REQUIRED: Gemini AI API Key for smart follow-up suggestions
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Additional configurations
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Firebase configuration is already set in .env file
# No need to change these unless you want to use a different Firebase project

# Mailchimp (server only). Profile → Extras → API keys. The key ends with -usNN.
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=2e5bc4f3ca
# MAILCHIMP_STUDENTS_AUDIENCE_ID=

# Call API integration (Kommuno). Leave commented until the account is saved in admin.
# Webhook URLs for Kommuno are the production API, never localhost:
#   https://canam.co.in/api/kommuno/webhook
#   https://canam.co.in/api/kommuno/incoming
#   https://canam.co.in/api/kommuno/recording
# KOMMUNO_BASE_URL=
# KOMMUNO_API_KEY=
# KOMMUNO_SME_ID=
# KOMMUNO_PILOT_NUMBERS=
# KOMMUNO_RECORDING=1
# KOMMUNO_WEBHOOK_TOKEN=
# KOMMUNO_AGENT_MAP=
